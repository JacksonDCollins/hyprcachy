[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Publish the preflight-compiled window-session binary
When = PostTransaction
Exec = /bin/sh -c "test ! -x /usr/lib/hyprcachy/window-session/transaction-gate || exec /usr/lib/hyprcachy/window-session/transaction-gate post"
