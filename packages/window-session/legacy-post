#!/usr/bin/bash -p
# Migration only: finish the installed pre-adapter plugin guard's approved build.
# New transactions never create this state. No transaction replay lives here.
set -euo pipefail
export PATH=/usr/bin LC_ALL=C
umask 077
[[ ${1:-} == post ]] || { echo 'Upgrade the plugin and shared guard together.' >&2; exit 1; }
(( EUID == 0 )) || exit 1
state=/run/hyprcachy-window-session
[[ -d $state && ! -L $state ]] || exit 0
[[ $(stat -c '%u:%a' "$state") == 0:700 && ! -L "$state/maintenance.lock" ]] || exit 1
exec 9>"$state/maintenance.lock"
flock -x 9
[[ -f "$state/active" && ! -L "$state/active" ]] || exit 0
stage=$(< "$state/active")
[[ $stage =~ ^/var/cache/hyprcachy-preflight\.[a-zA-Z0-9]{6}$ && ! -L $stage ]] || exit 1
[[ -d $stage ]] || exit 0
[[ $(stat -c '%u:%a' "$stage") == 0:700 ]] || exit 1
[[ -f "$stage/authorized" && $(< "$stage/pid") == "$PPID" ]] || exit 0
cmp -s "$stage/command" "/proc/$PPID/cmdline"
# A pacman self-upgrade can unlink the still-running parent's executable.
case $(readlink -f "/proc/$PPID/exe") in
    /usr/bin/pacman|'/usr/bin/pacman (deleted)') ;;
    *) exit 1 ;;
esac
pacman -Q | sort > "$stage/installed.actual"
cmp -s "$stage/check/installed.expected" "$stage/installed.actual"
[[ ! -e "$stage/root" && ! -f "$stage/check/build-tmux" ]]
file=$stage/check/build/window-session.so
[[ -f $file && ! -L $file ]]
(cd "$stage/check/build"; sha256sum --check --strict ../../artifacts.sha256)
current=$(cd "$stage/check/build"; sha256sum window-session.so)
grep -qxF "$current" "$stage/artifacts.sha256"
# shellcheck source=../upgrade-guard/gate-lib.sh
source /usr/lib/hyprcachy/upgrade-guard/gate-lib.sh
publish_file "$file" 0644 /usr/lib/hyprcachy/window-session/window-session.so
rm -f -- "$state/active"
rm -rf -- "$stage"
echo 'Published the legacy window-session preflight build; no desktop restart was performed.'
