# Pacman lifecycle: activate the packaged timer without touching the desktop.
system_live() {
    ! systemd-detect-virt --quiet --chroot && systemd-notify --booted
}
post_install() {
    if system_live; then
        systemctl daemon-reload && systemctl start hyprcachy-upgrade-cleanup.timer
    fi
}
post_upgrade() {
    post_install
}
pre_remove() {
    if system_live; then
        systemctl stop hyprcachy-upgrade-cleanup.timer hyprcachy-upgrade-cleanup.service
    fi
}
