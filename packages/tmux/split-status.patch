+/* Number of status rows above the panes. Split puts only row zero there. */
+u_int
+status_top_size(struct client *c)
+{
+	u_int	lines = status_line_size(c);
+
+	if (lines == 0)
+		return (0);
+	if (c->session->statusat == 0)
+		return (lines);
+	if (c->session->statusat == 2 && lines > 1)
+		return (1);
+	return (0);
+}
+
+/* Translate a status-screen row to a terminal row (also used for prompts). */
+u_int
+status_line_y(struct client *c, u_int line)
+{
+	u_int	lines = status_line_size(c);
+	int	position;
+
+	position = options_get_number(c->session->options, "status-position");
+	if (lines == 0)
+		lines = 1;
+	if (position == 0 || (position == 2 && lines > 1 && line == 0))
+		return (line);
+	if (c->tty.sy < lines - line)
+		return (0);
+	return (c->tty.sy - lines + line);
+}
+
+/* Translate a terminal row to a status-screen row, or -1 for pane content. */
+int
+status_line_at(struct client *c, u_int y)
+{
+	u_int	lines = status_line_size(c), top = status_top_size(c);
+
+	if (y < top)
+		return (y);
+	if (lines > top && c->tty.sy >= lines - top &&
+	    y >= c->tty.sy - (lines - top) && y < c->tty.sy)
+		return (y + lines - c->tty.sy);
+	return (-1);
+}
+
